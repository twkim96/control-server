# launchd/run.sh가 source하는 비밀값 파일.
# launchd/run.env로 복사 후 값 채우기. run.env 자체는 .gitignore로 추적 제외.

# 컨트롤 페이지 로그인 비밀번호 (필수).
CONTROL_PASSWORD=changeme

# 세션 쿠키 서명용 secret (선택). 비워두면 backend/runtime/.secret_key 자동 생성.
# CONTROL_SECRET_KEY=

# file_check의 19금 노벨피아 검색 보완용 이메일 로그인.
# 코드/config.yml에는 넣지 않고 이 ignore 파일에서만 관리한다.
FILE_CHECK_NOVELPIA_EMAIL=
FILE_CHECK_NOVELPIA_PASSWORD=

# file_check SQLite 카탈로그를 기존 Google Sheet에 덮어쓰기 위한 설정.
# 서비스 계정 JSON은 로컬에만 보관하고, Sheet를 JSON의 client_email과 공유한다.
FILE_CHECK_GOOGLE_CREDENTIALS=
FILE_CHECK_GOOGLE_SPREADSHEET_ID=
