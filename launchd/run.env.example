# launchd/run.sh가 source하는 비밀값 파일.
# launchd/run.env로 복사 후 값 채우기. run.env 자체는 .gitignore로 추적 제외.

# 컨트롤 페이지 로그인 비밀번호 (필수).
CONTROL_PASSWORD=changeme

# 세션 쿠키 서명용 secret (선택). 비워두면 backend/runtime/.secret_key 자동 생성.
# CONTROL_SECRET_KEY=

# v1.4.0 PM2 runtime overrides (선택).
# 기본값은 Homebrew Node와 저장소 내부의 pinned PM2/격리 runtime 경로다.
# CONTROL_PM2_NODE=/opt/homebrew/bin/node
# CONTROL_PM2_CLI=/path/to/control-server/ops/pm2/node_modules/pm2/bin/pm2
# CONTROL_PM2_HOME=/path/to/control-server/backend/runtime/pm2

# 장기 실행 서비스는 격리 PM2 runtime으로 관리한다.
CONTROL_PROCESS_BACKEND=pm2
